{
  "name": "solari-chow",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "demo": "npm --workspace=chow-fleet start",
    "fleet": "npm --workspace=chow-fleet start",
    "factory": "npm --workspace=part-card-factory start",
    "honesty": "npm --workspace=honesty-desktop start",
    "onboarding": "npm --workspace=onboarding-wizard start --",
    "verify": "node scripts/verify-mock.mjs && node scripts/secret-scan.mjs && node scripts/verify-video.mjs",
    "shop-live": "npx tsx scripts/shop-live-serve.mjs",
    "shop-live-kill": "npx tsx scripts/shop-live-kill.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "motion": "^13.1.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
